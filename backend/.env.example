# Verity Backend Configuration
PROJECT_NAME="VERITY - Multimodal Fraud Prevention"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./verity.db"

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
