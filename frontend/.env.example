# Frontend Environment Variables
# Copy this file to .env and configure values for your environment.

# Backend API base URL — update this when deploying to a remote server
VITE_API_BASE_URL=http://localhost:8000

# GEMINI_API_KEY: Required for Gemini AI API calls (set in backend .env, not here).
# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
